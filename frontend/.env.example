# Frontend environment template. Copy to frontend/.env.local and fill in.
# Everything prefixed VITE_ is bundled into the browser: never put secrets here.

# Clerk publishable key (public by design, starts with pk_)
VITE_CLERK_PUBLISHABLE_KEY=

# Base URL of the backend API, e.g. http://localhost:4000
# (Misnamed: this is a URL, not a key. Rename tracked for Phase 2.)
VITE_REACT_APP_API_KEY=
