{
  "name": "backend",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "start": "node index.js",
    "dev": "nodemon index.js",
    "typecheck": "tsc -p tsconfig.json",
    "test": "node --test --test-concurrency=1 test/*.test.js",
    "prisma:validate": "prisma validate",
    "prisma:drift": "prisma migrate diff --from-migrations prisma/migrations --to-schema-datamodel prisma/schema.prisma --shadow-database-url \"$SHADOW_DATABASE_URL\" --exit-code",
    "migrate:deploy": "prisma migrate deploy",
    "admin:grant": "node scripts/admin-grant.js",
    "jobs:complete-events": "node scripts/complete-events.js",
    "postinstall": "prisma generate"
  },
  "keywords": [],
  "author": "",
