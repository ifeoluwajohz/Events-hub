# Backend environment template. Copy to backend/.env and fill in locally.
# Never commit real values. Prisma loads this file automatically.

# PostgreSQL connection string used by Prisma
DATABASE_URL=

# Secret used to sign the backend's session JWTs (long random string)
JWT_SECRET=

# Firebase Admin service account (used to verify Firebase ID tokens at login).
# Option A (recommended for hosting): the full JSON, or its base64 encoding
FIREBASE_SERVICE_ACCOUNT_JSON=
# Option B (local dev): path to a key file kept OUTSIDE git
# (defaults to backend/configs/serviceAccountKey.json, which is gitignored)
FIREBASE_SERVICE_ACCOUNT_PATH=

# HTTP port for the API (defaults to 5173, which clashes with Vite; 4000 recommended)
PORT=4000
