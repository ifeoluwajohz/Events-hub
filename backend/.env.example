# Backend environment template. Copy to backend/.env and fill in locally.
# Never commit real values. In production all required values come from the host.

NODE_ENV=development

# PostgreSQL connection string used by Prisma (required)
DATABASE_URL=

# Clerk (required in production). Use the keys of the same Clerk instance as the frontend.
# The secret key is SECRET; rotate it if it was ever committed (docs/SECURITY.md).
CLERK_SECRET_KEY=
CLERK_PUBLISHABLE_KEY=
# Optional but recommended: the instance's PEM public key (Clerk dashboard > API keys > JWT public key).
# Lets the API verify session tokens without a network call. Use \n for newlines.
CLERK_JWT_KEY=
# Origins allowed to have issued session tokens (Clerk "azp"). Defaults to CORS_ORIGINS.
CLERK_AUTHORIZED_PARTIES=

# Exact browser origins allowed by CORS, comma-separated (required in production),
# e.g. https://theevent.example,https://www.theevent.example
CORS_ORIGINS=http://localhost:5173

# Set to true when running behind a reverse proxy/load balancer (correct client IPs for rate limits)
TRUST_PROXY=false

# HTTP port for the API
PORT=4000

# Tests only: Postgres server used to create throwaway test databases, and a scratch
# database for the schema-drift check. Never point these at a real environment.
TEST_DATABASE_ADMIN_URL=postgresql://postgres@localhost:5432/postgres
SHADOW_DATABASE_URL=postgresql://postgres@localhost:5432/events_shadow
